# Copy to .env.local to override defaults. Everything here is public (NEXT_PUBLIC_*)
# because Staries never holds private keys: authors sign with their own wallet.

# "testnet" (default) or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional: use a different Horizon server
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
